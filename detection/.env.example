# Google Earth Engine Cloud project id — same value as data-pipeline/.env.
# detection/src/_data_pipeline.py reads this file (falling back to
# ../data-pipeline/.env if this one is absent) so the cross-project GEE
# calls it re-exports are authenticated the same way data-pipeline's own
# code is. See data-pipeline/.env.example and src/auth.py for details.
EE_PROJECT_ID=
