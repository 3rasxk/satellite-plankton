# No real Supabase project exists yet -- these are intentionally blank.
# Leave DATABASE_URL blank to use a local SQLite file
# (backend/data/app.db, gitignored) as a stand-in, so the full DB-backed
# flow (schema, scheduler cache writes, /risk-map, /summary) can be built
# and tested now. To swap to real Supabase/Postgres later, set
# DATABASE_URL to a real connection string, e.g.:
#   DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
# That single env var is the entire swap -- src/db.py and src/db_models.py
# don't branch on "is this sqlite" anywhere. (psycopg2-binary would need
# adding to requirements.txt for a real Postgres URL -- not installed
# here since there is nothing to connect to yet.)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Scheduler interval for refreshing the monitored grid's cached detection
# results (src/scheduler.py). Satellite data doesn't update faster than
# Sentinel-2's ~5-day revisit / MODIS daily composite, so short intervals
# don't buy fresher pixels -- 360 (6h) is a reasonable default. Override
# with a small value only for local testing of the scheduler firing.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=360

# TEST seasonal baseline for the Sentinel-2 NDCI signal anomaly. Off by
# default; only the exact value `test` enables it (`TEST`, `true`, `1` or
# blank all mean off). Write it unquoted: spaces around the value in this
# file are stripped, but quotes are kept, so BASELINE_MODE="test" is off.
# When enabled, the backend reads the newest artefact
# under backend/data/baselines/ (built by scripts/build_test_baseline.py) and
# uses it only if it validates against today's preprocessing settings. It is
# a TEST baseline: provisional and uncalibrated -- never checked against
# recorded bloom events -- so what it flags is a statistical anomaly of a
# site against its own seasonal record, not a bloom detection and not a
# risk level. Risk evaluation stays off in either mode.
BASELINE_MODE=off

# Latest-scene policy (src/raster_scan/trigger.py). Every poll assesses
# each new Sentinel-2 acquisition date for cloud over the polygon's water
# (thresholds RASTER_SCENE_MAX_CLOUD_FRACTION / RASTER_SCENE_MIN_WATER_PIXELS,
# set in data-pipeline/.env) and starts a raster scan at once for the newest
# PASSING date newer than the newest date already used, then refreshes the
# 7 sites. A rejected (cloudy) date starts nothing; the previous raster
# keeps serving.
#
# POLL_INTERVAL_HOURS: how often to poll (default 1; was 3).
# MIN_INTERVAL_HOURS: minimum time between two scan attempts, counted from
#   the latest attempt of any status -- spaces retries of an errored scan;
#   a new passing scene can wait up to this long (default 1).
# COOLDOWN_HOURS: gates only the first-install bootstrap while no date has
#   passed (no successful raster yet): it then starts at most once per this
#   many hours. A qualifying new scene never waits for it.
# POLL_LOOKBACK_DAYS: how far back the assessment looks for acquisition
#   dates (it never starts before the newest date already used). Bounds
#   the query only, and never decides which scene a reading comes from.
# How stale a reading may be is not set here: that is one system-wide
# rule, SENTINEL2_MAX_SCENE_AGE_DAYS, in data-pipeline/.env.
RASTER_SCAN_POLL_INTERVAL_HOURS=1
RASTER_SCAN_MIN_INTERVAL_HOURS=1
RASTER_SCAN_COOLDOWN_HOURS=20
RASTER_SCAN_POLL_LOOKBACK_DAYS=10

# Wall-clock budget (minutes) for the first-install bootstrap search, which
# pages 15-day windows back to the Sentinel-2 archive start until one is
# usable. Checked between windows. When exceeded, the run ends as
# status='error' with the windows it did search recorded -- never presented
# as a complete search -- and the next poll retries. Must be below the 60-min
# stale-run threshold in src/raster_scan/scan.py (STALE_RUN_HOURS); a value
# that is not is refused at scan time.
RASTER_BOOTSTRAP_BUDGET_MINUTES=45

# Raster scan (src/raster_scan/): the whole-polygon spectral-index
# composite, stored as an on-disk blob under backend/data/rasters/<run_id>/
# (gitignored, same as the SQLite DB above).
#
# RASTER_SCAN_SCALE_M is the read scale in metres. Measured live over the
# study polygon: 200 -> 49,607 valid water cells / ~9.2 MB / ~10 s;
# 100 -> 196,424 cells / 36.8 MB. Set 100 for the finer read. This does
# NOT set how old a contributing scene may be -- that stays the one
# system-wide SENTINEL2_MAX_SCENE_AGE_DAYS in data-pipeline/.env.
#
# RASTER_RETENTION_DAYS is how long the full blob is kept. Past it, the
# run is reduced to the summary already stored on its row and the blob is
# deleted; the run row itself is never removed. The summary's per-cell
# acquisition date is a mode, never a mean -- see
# data-pipeline/src/raster.py's RASTER_BAND_REDUCERS.
RASTER_SCAN_SCALE_M=200
RASTER_RETENTION_DAYS=30
